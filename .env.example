# ═══════════════════════════════════════════════════════════════
#  Secretos del Mini Data Center  →  copia este archivo como .env
#     Linux/macOS:  cp .env.example .env
#     Windows:      copy .env.example .env
#  y CAMBIA todas las contraseñas. El archivo .env NUNCA se sube a Git.
#  Evita comillas ( ' " ) y espacios en las contraseñas.
# ═══════════════════════════════════════════════════════════════

# Puertos publicados en tu laptop / VM
LB_PUERTO=8080
GRAFANA_PUERTO=3000
DB_PUERTO=3307        # MariaDB en el host (3306 suele estar ocupado)

# MariaDB
DB_ROOT_PASSWORD=CambiaEsto_Root_2026
APP_DB_PASSWORD=CambiaEsto_App_2026
GRAFANA_DB_PASSWORD=CambiaEsto_Lectura_2026

# Acceso a Grafana (solo se aplica la PRIMERA vez que arranca)
GRAFANA_ADMIN_USER=admin_dc
GRAFANA_ADMIN_PASSWORD=CambiaEsto_Grafana_2026
